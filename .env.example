# LLM for text mode / evals (any OpenAI-compatible API)
OPENAI_API_KEY=
# PJVOICE_LLM_BASE_URL=https://openrouter.ai/api/v1
# PJVOICE_LLM_API_KEY=
# PJVOICE_KEEP_MODEL_PREFIX=1     # send "openai/gpt-4.1-mini" as-is (OpenRouter-style)

# LiveKit (voice worker; STT/LLM/TTS go through LiveKit Inference)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Control plane
PJVOICE_DB=pjvoice.db
PJVOICE_API_KEY=change-me          # management API (/v1/*)
PJVOICE_AGENT_KEY=change-me-too    # worker API (/agent/*)
PJVOICE_CONTROL_URL=http://localhost:8000

# Reference tool server
PJVOICE_TOOLS_KEY=
TOOLS_URL=http://localhost:8100/tools
